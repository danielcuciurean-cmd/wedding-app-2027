rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // UID-urile celor doi utilizatori. TODO: înlocuiește UID_MIREASA cu UID-ul contului miresei.
    function allowed() {
      return request.auth != null &&
        request.auth.uid in ['MoE1p1LyapO40EuNn9Oi9dlfHBo1', 'UID_MIREASA'];
    }
    match /{document=**} {
      allow read, write: if allowed();
    }
  }
}
